'use server'

import { GoogleGenAI } from '@google/genai'
import { createClient } from '@/lib/supabase/server'
import { analyzeStock } from '@/lib/analysis/technical'

const gemini = new GoogleGenAI({
  apiKey: process.env.GEMINI_API_KEY,
})

export async function askAnalyst(question: string, ticker: string) {
  const supabase = await createClient()

  let context = ''

  if (ticker) {
    const cleanTicker = ticker.trim().toUpperCase()

    const { data: stock } = await supabase
      .from('stocks')
      .select('*')
      .eq('ticker', cleanTicker)
      .single()

    const { data: price } = await supabase
      .from('latest_prices')
      .select('*')
      .eq('ticker', cleanTicker)
      .single()

    if (stock) {
      context = `Data saham ${cleanTicker} (${stock.name}): harga terakhir Rp${price?.price ?? 'tidak tersedia'}, volume ${price?.volume ?? 'tidak tersedia'}.`
    }
  }

  const systemPrompt = `Kamu adalah AI Analyst di aplikasi StockFamily, terminal analisa saham IDX.

Tugasmu:
- Menjawab pertanyaan user tentang saham Indonesia/IDX.
- Jawab singkat, jelas, dan mudah dipahami.
- Gunakan data yang diberikan sebagai sumber utama.
- Jangan mengarang harga, volume, indikator, atau data pasar yang tidak diberikan.
- Jika data tidak tersedia, katakan bahwa data tersebut tidak tersedia.
- Bedakan fakta dari interpretasi.
- Jangan memberikan kepastian profit atau jaminan harga.
- Selalu ingatkan bahwa analisis ini bukan rekomendasi investasi resmi, hanya alat bantu analisa.

${context ? `Konteks data terkini:\n${context}` : 'Tidak ada data saham spesifik yang diberikan.'}`

  const prompt = `${systemPrompt}

Pertanyaan user:
${question}`

  const response = await gemini.models.generateContent({
    model: 'gemini-3.6-flash',
    contents: prompt,
  })

  return response.text || 'Maaf, tidak ada jawaban.'
}

export async function getLocalAnalysis(ticker: string) {
  const supabase = await createClient()
  const cleanTicker = ticker.trim().toUpperCase()

  const { data: candles } = await supabase
    .from('stock_ohlcv')
    .select('*')
    .eq('ticker', cleanTicker)
    .order('date', { ascending: true })

  if (!candles || candles.length < 20) {
    return null
  }

  const { data: stock } = await supabase
    .from('stocks')
    .select('*')
    .eq('ticker', cleanTicker)
    .single()

  const analysis = analyzeStock(
    candles.map((c) => ({
      date: c.date,
      open: Number(c.open),
      high: Number(c.high),
      low: Number(c.low),
      close: Number(c.close),
      volume: Number(c.volume),
    }))
  )

  return {
    ticker: cleanTicker,
    name: stock?.name ?? cleanTicker,
    ...analysis,
  }
}
